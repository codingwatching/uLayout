:root {
}

.sizing-label {
    -unity-text-align: upper-right;
    margin-top: 2px;
    margin-bottom: 2px;
}

.section-container {
    background-color: rgba(0, 0, 0, 0.149);
    margin-top: 3px;
    margin-bottom: 3px;
    padding-top: 0;
    padding-bottom: 2px;
    margin-left: 3px;
    margin-right: 3px;
    padding-left: 0;
    padding-right: 0;
}

.section-header {
    background-color: rgba(0, 0, 0, 0.251);
    margin-left: 0;
    padding-left: 3px;
    padding-top: 2px;
    padding-bottom: 2px;
    margin-bottom: 3px;
    -unity-font-style: bold;
}
